# Backend configuration (copy to .env or set in your shell). All optional.
# Folder containing model.joblib, features.joblib, metadata.json (relative paths resolve from the project root)
OCCUPANCY_MODELS_DIR=models
# Extra comma-separated CORS origins. http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
OCCUPANCY_CORS_ORIGINS=
OCCUPANCY_LOG_LEVEL=INFO
